{% extends 'base.html.twig' %}

{% block body %}
    <div class="container" data-controller="video">
        <section class="row g-4 justify-content-center">
            <div class="col-12 col-md-8 col-xl-6">
                <div class="ratio ratio-16x9">
                    <iframe class="media embed-responsive-item" src="{{ anims[0].lien }}" allowfullscreen
                            title="{{ anims[0].auteur ~ '-' ~ anims[0].titre }}" style="width:100%"></iframe>
                </div>
            </div>
        </section>
        <section class="row g-4 pt-4 justify-content-center">
            <div class="col-12 col-md-8 col-xl-6 text-center my-auto p-5">
                <img src="{{ asset('images/shufler_logo.png') }}" width=50% alt="logo Shufler"
                     title="logo Shufler"><br>
                <h1>des clips en vrac..</h1><br><br>
                <div style="text-align:center">
                    <a class="btn btn-dark" href="{{ path('main_home') }}" role="button" aria-label="Reload"
                       style="background-color:black"><i
                            class="bi bi-dice-{{ random(5) + 1 }}-fill"></i>&nbsp;{{ 'New Selection'|trans }}
                        <i class="bi bi-dice-{{ random(5) + 1 }}-fill"></i></a>&nbsp;&nbsp;
                    {% if not app.user %}
                        <a id="register_second" class="btn btn-dark" role="button" aria-label="Create an account"
                           data-toggle="modal" data-target="#userModal" href="{{ path('account') }}"
                           style="background-color:black">
                            <span class="glyphicon glyphicon-flag"></span>&nbsp;{{ 'Create an account'|trans }}</a>
                    {% endif %}
                    {% if is_granted('ROLE_AUTEUR') %}
                        <a href="{{ path('video_edit', {'id':anims[0].id}) }}" role="button" aria-label="Edit the video"
                           class="link-edit btn btn-dark"
                        ><i class="bi bi-pencil-square"></i></a>
                    {% endif %}
                </div>
            </div>
        </section>

        <!-- ANIMS !-->
        <section class="row g-4 justify-content-center">
            <div class="row col-12 col-xl-8 mx-auto">
                {% for video in anims|slice(1, 5) %}
                    <div
                        class="col-12 col-sm-6 col-lg-4 order-{{ loop.index%2 == 0 ? loop.index + 2 : loop.index + 1 }} order-sm-{{ loop.index%2 == 0 ? loop.index + 1 : loop.index + 2 }} order-lg-{{ loop.index + 1 }} g-2">
                        <twig:VideoFrame :video="video"/>
                    </div>
                    <div
                        class="col-12 col-sm-6 col-lg-4 justify-content-center order-{{ loop.index%2 == 0 ? loop.index + 1 : loop.index + 2 }} order-sm-{{ loop.index%2 == 0 ? loop.index + 2 : loop.index + 1 }} order-lg-{{ loop.index + 2 }}">
                    </div>
                {% endfor %}
            </div>
        </section>
        <br><br>

        <!-- Son & Images !-->

        <section class="row justify-content-center" style="background-color:black;">
            <div class="row col-12 mx-auto p-4">
                <div class="text-center p-4">
                    <h2>Du son, des images</h2>
                    <p>Une palanquée de morceaux d'anthologie, parfois méconnus, amoureusement choisis</p>
                </div>
                <div class="row d-flex justify-content-around">
                    {% for video in musics|slice(0, 4) %}
                        <div class="col-12 col-sm-6 col-lg-3 col-xl-2 g-4 g-sm-2">
                            <twig:VideoFrame :video="video" categorie="true"/>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- Juke-Box !-->

        <section class="row g-4">
            <div class="col-12 col-lg-3 p-4 mx-auto" data-controller="music">
                <div class="text-center">
                    <h2>Juke-Box</h2>
                    <p>Des morceaux de choix</p>
                    <a href="{{ path('main_juke-box') }}" data-turbo-frame="juke-box">
                        Reload
                    </a>
                </div>
                <turbo-frame id="juke-box" src="{{ path('main_juke-box') }}" loading="lazy">
                    <div class="d-flex justify-content-center">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="font-size:6em;color:orange;"></span>
                    </div>
                </turbo-frame>
            </div>

            <!-- Encart Villemot !-->

            <div class="col-12 col-lg-6 p-4 mx-auto text-center mt-0 my-lg-auto">
                {% set r = "%02d"|format(random(1,90)) %}
                <img src="{{ asset(illustration_dir~'/'~r~'.jpg') }}" loading="lazy" style="width:50%;" alt="Publicité" title="Publicité">
            </div>

            <!-- OMG !-->

            <div class="col-12 col-lg-3 p-4 text-center mx-auto" style="background-color:#4d1500;">
                <h2>OMG, WTF ??</h2>
                <p>Du bizarre, du cheulou comme disent les jeunes.. On y trouve aussi du mdr, voire du ptdr</p>
                <div class="row g-4 row-cols-1 row-cols-sm-2 row-cols-lg-1 p-2">
                    {% for video in stranges|slice(0, 4) %}
                        <div>
                            <twig:VideoFrame :video="video"/>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
        <br>

        <!-- Etc !-->

        <section class="row g-4 p-4" style="background-color:#4a008f;">
            <h2 style="text-align: center;">En v'la encore...</h2>
            <div class="row d-flex justify-content-around mx-auto">
            {% for video in musics|slice(4,12) %}
                <div class="col-12 col-sm-6 col-lg-4 col-xl-2 g-4 g-sm-2">
                    <twig:VideoFrame :video="video" categorie="true"/>
                </div>
            {% endfor %}
            </div>
        </section>
    </div>
{% endblock %}
