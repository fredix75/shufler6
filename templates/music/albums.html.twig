{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} :: Music Albums{% endblock %}

{% block body %}
    <div class="row d-flex row-cols-1 row-cols-md-3 row-cols-lg-6 justify-content-center"
         data-controller="album">
        {% for album in albums %}
            {% if album.picture is not null %}
                <div class="g-4 media-vignette album">
                    <twig:AlbumFrame :album="album"/>
                </div>
            {% endif %}
        {% endfor %}
        {% if pagination is not empty %}
            <section class="col-sm-12 col-md-12" style="margin-top: 20px;">
                <twig:Pagination :pagination="pagination"/>
            </section>
        {% endif %}
    </div>
    {% include 'part/_modal.html.twig' with { modalTitle: 'Music', class: 'music-modal' } %}
    {% include 'music/part/_filters.html.twig' %}
{% endblock %}
