{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} :: Couch Filters{% endblock %}

{% block body %}
    <div class="p-4">
        <h1 class="minor"><i class="bi bi-filter-circle"></i>&nbsp;Filtres</h1>
        <div class="well">
            <div class="row justify-content-center txt-center">
                <div class="col-12 col-lg-6 mx-auto">
                    {{ form_start(form, {'action': path('radial_couch'), 'method': 'GET'}) }}
                    {{ form_widget(form) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
