{% extends 'part/_slider.html.twig' %}

{% block slider_content %}
    <style>
        .ts-dropdown {
            top: auto !important;
            bottom: 100% !important;
        }
    </style>
    {{ form_start(form_cinema, {'action': path(app.current_route), 'method' : 'GET'}) }}
    <div class="row justify-content-center align-items-center filter-form">

        <div class="col-6 col-md-4 col-lg-2">
            {{ form_row(form_cinema.genres) }}
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            {{ form_row(form_cinema.search) }}
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            {{ form_row(form_cinema.director) }}
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            {{ form_row(form_cinema.annee) }}
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <button class="btn btn-primary">OK</button>
        </div>
    </div>
    {{ form_end(form_cinema) }}
{% endblock %}
