{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} :: Trash{% endblock %}

{% block body %}
    <section class="row d-flex row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 m-4" data-controller="video">
            <div class="col col-12 col-sm-6 col-md-6 col-lg-3 media-select" style="">
                <h1>Trash <i class="bi bi-trash-fill"></i></h1>
            </div>
            {% for video in videos %}
                <div class="g-4 media-vignette">
                    <twig:VideoFrame :video="video" categorie="true"/>
                </div>
            {% endfor %}
        </section>
        <twig:Pagination :pagination="pagination" />
{% endblock %}
