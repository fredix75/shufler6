{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} :: Playlists Youtube{% endblock %}

{% block body %}
    <h1><i class="bi bi-youtube"></i> Youtube playlists</h1>
    <section class="row d-flex row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xl-6 m-4"
             data-controller="video">
        {% for playlist in playlists %}
            <div class="g-4 media-vignette">
                <twig:SquareFrame :playlist="playlist" />
            </div>
        {% endfor %}
    </section>
{% endblock %}
