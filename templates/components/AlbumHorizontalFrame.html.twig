{% extends 'components/HorizontalCard.html.twig' %}

<twig:block name="picture">
    {% if album.picture is not null %}
        <img src="{{ album.picture }}" class="img-fluid rounded-start"
             alt="{{ album.auteur ~ '-' ~ album.name }}" loading="lazy">
    {% endif %}
</twig:block>
<twig:block name="title">{{ album.name }}</twig:block>
<twig:block name="content">
    <div class="card-subtitle">{{ album.auteur }}</div>
    <span>{{ album.annee }}</span>
    <div class="text-center mt-2">
        <a type="button" class="btn btn-secondary" href="{{ path('music_couch', {'album': album.name, 'auteur': album.auteur}) }}"><i class="bi bi-check-circle-fill"></i></a>
    </div>
</twig:block>
