<div class="media embed-responsive-16by9">
    <a class="video-link" href="{{ this.video.lien|popUp }}" aria-label="Launch video {{ this.video.titre }}">
        {{ convertFrame(this.video.lien, this.video.auteur ~ '-' ~ this.video.titre) }}
    </a>
</div>
<div class="media-body">
    <div class="d-flex justify-content-between p-2">
        <span class="categorie">
            {% if this.categorie %}
                <a
                    href="{{ path('video_list', {'categorie' : this.video.categorie, 'genre' : this.video.genre }) }}"
                    aria-label="Go to category {{ video.genre ? video.genre|genreDisplay : video.categorie|categorieDisplay }}">{{ video.genre ? video.genre|genreDisplay : video.categorie|categorieDisplay }}</a>
            {% endif %}
        </span>
        <span></span>
    </div>
    <div class="text-center p-2">
        <h3 class="media-heading">{{ this.video.titre }}</h3>
        <h4>{{ this.video.auteur }}</h4>
    </div>
    <div class="d-flex justify-content-between p-2">
        <span>
            {% if is_granted('VIDEO_EDIT', this.video) %}
                    <a href="{{ path('video_edit',{ 'id': this.video.id }) }}" class="link-edit" role="button"
                       aria-label="Edit video {{ this.video.titre }}">
                    <i class="bi bi-pencil-square"></i>
                </a>
            {% endif %}
        </span>
        <span>{{ this.video.annee|yearDisplay }}</span>
    </div>
</div>

