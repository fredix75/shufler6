<div{{ attributes }}>
    <div class="card">
        <div class="row g-0">
            <div class="col-4" style="overflow: hidden;">
                <a class="video-link" href="{{ this.piece.youtubeKey|popUpYoutube }}"
                   data-action="music#popup">
                    <img src="{{ this.piece.albumPicture|default(asset('images/no_cover.jpeg')) }}"
                         class="img-fluid rounded-start"
                         alt="{{ this.piece.author ~ ' ' ~ this.piece.title }}" title="{{ this.piece.author ~ ' ' ~ this.piece.title }}" loading="lazy" width="100%">
                </a>
            </div>
            <div class="col-8 d-flex flex-column">
                <div class="card-body">
                    <h5 class="card-title">{{ this.piece.title }}</h5>
                    <span class="card-subtitle"><small>{{ this.piece.author|upper }}</small></span><br>
                    <span class="card-subtitle"><small>{{ this.piece.albumName }}</small></span>
                    <div class="card-text d-flex justify-content-between"><strong>{{ this.piece.year|yearDisplay }}</strong><span class="categorie" style="font-size:60%;color:grey">{{ this.piece.kind }}</span></div>
                </div>
                <div class="d-flex justify-content-end gap-4 px-2 pb-1 mt-auto">
                    <a href="#" class="text-secondary" title="Favori" data-action="music#setNote" data-id={{ this.piece.youtubeKey }} data-note={{ this.piece.note > 0 ? -1 : 4 }}><i class="bi bi-heart{{ this.piece.note > 0 ? '-fill' : '' }}"></i></a>
                    <a href="#" class="text-secondary" title="Ajouter à une playlist"><i class="bi bi-pencil"></i></a>
                 </div>
            </div>
        </div>
    </div>
</div>
